#!/bin/sh
# OMK-12827 Slice B: encryption-of-secrets prerequisites.
#
# 1. Detect the crypto perl modules and report clearly when they are
#    missing, WITHOUT aborting the install: offline sites must still
#    complete upgrades (OMK-12827 item 2), they just cannot enable
#    encryption until the modules are present. Runtime fails closed.
# 2. Create the master key at the shipped default path if absent
#    (items 3 and 4). Created here, at install time as root, because
#    NMISNG::Util::_make_seed refuses to run for non-root processes, so
#    the first process to need a key (apache CGI, the daemon) cannot
#    create it and would fail closed instead.
#
# A custom master_key_file configured in Config.nmis is deliberately NOT
# handled here: NMIS only ever creates a key at the shipped default path;
# an operator who configures a custom location provisions the key there
# themselves. An existing key is never modified, rotated or relocated:
# values already encrypted with it would become permanently undecryptable.

# find out where we are, and get common functions
SCRIPTPATH=${0%/*}
. $SCRIPTPATH/common_functions.sh
. $SCRIPTPATH/common_masterkey.sh

# guesses os flavour, sets OSFLAVOUR
flavour

if [ "$OSFLAVOUR" = "redhat" ]; then
	WEBOWNER=apache
else
	WEBOWNER=www-data
fi

printBanner "Checking encryption-of-secrets prerequisites"

# --- crypto module detection (OMK-12827 item 2): report, never abort ---
MISSING_MODULES=""
for m in Crypt::CBC Crypt::Cipher::AES Math::Random::Secure; do
	if ! perl -e "require $m" >/dev/null 2>&1; then
		MISSING_MODULES="$MISSING_MODULES $m"
	fi
done

if [ -n "$MISSING_MODULES" ]; then
	echolog "WARNING: the following Perl modules are not installed:$MISSING_MODULES"
	echolog "Encryption of secrets cannot run until they are installed:"
	echolog "  Debian/Ubuntu: apt-get install libcrypt-cbc-perl libcryptx-perl libmath-random-secure-perl"
	echolog "  RedHat:        yum install perl-Crypt-CBC perl-CryptX perl-Math-Random-Secure"
	echolog "The installation continues; secrets stay unencrypted until the modules are present."
else
	echolog "Crypto modules present (Crypt::CBC, Crypt::Cipher::AES, Math::Random::Secure)."
fi

# --- master key creation (items 3 and 4): default path only, only if absent ---
if [ -e "$NMIS_MASTERKEY_DEFAULT_FILE" ]; then
	# The key itself is never touched here, per the header. But "it exists" was
	# the only thing this branch used to check, and that hid a real failure: when
	# provisioning creates the key and then cannot chown it, the file is left in
	# place owned by root, the web tier cannot read it, and every later run of
	# this hook took that branch and reported nothing wrong. The ownership is now
	# verified on every run, so the warning survives the re-run that first
	# reported it.
	#
	# Verified, never corrected. This hook chowns only a key it created itself:
	# silently re-owning a pre-existing key would be a change to a file an
	# operator may have deliberately placed and permissioned, and it is a
	# one-line fix they can make with the command printed below.
	#
	# Root-scoped for the same reason the postcondition in
	# nmis_masterkey_provision is: a non-root run cannot chown anything, so it
	# would only be able to nag about something it cannot fix, on every install.
	masterkey_owner_wanted="${WEBOWNER}:nmis"

	if [ "$(id -u)" -ne 0 ]; then
		echolog "Master key file $NMIS_MASTERKEY_DEFAULT_FILE already exists; leaving it untouched."
	else
		masterkey_owner_got="$(nmis_masterkey_owner_ok "$WEBOWNER")"
		masterkey_owner_rc=$?
		case $masterkey_owner_rc in
		0)
			echolog "Master key file $NMIS_MASTERKEY_DEFAULT_FILE already exists; leaving it untouched."
			;;
		1)
			echolog "WARNING: master key file $NMIS_MASTERKEY_DEFAULT_FILE is owned by '${masterkey_owner_got:-unknown}', wanted '${masterkey_owner_wanted}'."
			echolog "The web user cannot read it, so encryption of secrets will not work until the ownership is corrected:"
			echolog "  chown ${masterkey_owner_wanted} $NMIS_MASTERKEY_DEFAULT_FILE"
			echolog "The key itself is left untouched; its contents are still valid and must not be replaced."
			;;
		*)
			echolog "WARNING: could not stat master key file $NMIS_MASTERKEY_DEFAULT_FILE to verify its ownership."
			;;
		esac
	fi
elif [ -n "${SIMULATE:-}" ]; then
	echolog "SIMULATION MODE: would create master key file $NMIS_MASTERKEY_DEFAULT_FILE"
elif nmis_masterkey_provision "$WEBOWNER"; then
	echolog "Created master key file $NMIS_MASTERKEY_DEFAULT_FILE for encryption of secrets."
else
	# Two different failures land here: nothing was created at all, or a key was
	# created and could not be given to the web user. The advice has to cover
	# both, because "re-run to create it" is a no-op in the second case - the
	# file exists, so the branch above is what a re-run reaches.
	echolog "WARNING: could not create or correctly own $NMIS_MASTERKEY_DEFAULT_FILE."
	echolog "Encryption of secrets cannot be enabled until a master key exists AND is readable by the web user."
	echolog "Re-run this hook as root to retry creation. If the file does exist, its ownership is what failed; correct it with:"
	echolog "  chown ${WEBOWNER}:nmis $NMIS_MASTERKEY_DEFAULT_FILE"
fi

exit 0
