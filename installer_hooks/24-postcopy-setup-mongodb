#!/bin/sh
# offer to setup mongodb auth and users, clean up historic stuff

# find out where we are, and get common functions
SCRIPTPATH=${0%/*}
. $SCRIPTPATH/common_functions.sh

# OMK-12709/OMK-12826: warn (never block, never rotate) when the effective
# db_password is a known shipped default. See common_dbpassword.sh for why
# this hook must not hand-edit db_password itself.
. $SCRIPTPATH/common_dbpassword.sh
nmis_dbpassword_classify "$TARGETDIR" && rc=0 || rc=$?
if [ "$rc" = 1 ] || [ "$rc" = 2 ]; then
		nmis_dbpassword_advice "$NMIS_DBPASSWORD_USER"
fi

if [ -e $TARGETDIR/admin/setup_mongodb.pl ]; then
		printBanner "Running MongoDB setup helper"

		if input_yn "Do you want to run the MongoDB setup helper now?" "473b"; then
				[ -n "$UNATTENDED" ] && EXTRAARGS='auto=true'
				[ -n "$PRESEED" ] && EXTRAARGS="$EXTRAARGS preseed=$PRESEED"
				$TARGETDIR/admin/setup_mongodb.pl $EXTRAARGS
				logmsg "MongoDB setup helper returned $?"
		else
				echolog "Skipping MongoDB setup helper as instructed."
				cat <<EOF

Database setup is now MANDATORY: NMIS cannot authenticate to MongoDB until
$TARGETDIR/admin/setup_mongodb.pl has been run as the root user. Run it
before starting NMIS.

EOF
		fi
fi

exit 0
