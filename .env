# The mongo root/admin identity. Set MONGODB_PASSWORD to a strong value before
# the first start: shipped EMPTY on purpose, a value here would be the same known
# password on every deployment. MONGO_INITDB creates this user on first boot only
# when both the name and password are set.
MONGODB_USERNAME=root
MONGODB_PASSWORD=
# The scoped nmis9RW application password (OMK-12826), DISTINCT from the root
# password above, so reading the app config or env does not yield the root
# password. Set it to a strong value, different from MONGODB_PASSWORD, before the
# first start. It must not be empty or a known default ('example', 'password',
# 'op42flow42', CHANGE_ME*), or the app cannot authenticate as nmis9RW:
# setup_mongodb.pl would generate a random password for the user while the app
# keeps authenticating with this value.
MONGODB_APP_PASSWORD=
NMIS_SERVER_NAME=nmis
NMIS_CLUSTER_ID=

# Password for the 'nmis' GUI login. Set your own before the first start: the
# container will not start without one. Shipped EMPTY on purpose, a value here
# would be the same known password on every deployment. Used only on first start.
# For a docker secret instead, leave this empty and set the _FILE form below.
NMIS_ADMIN_PASSWORD=

# Path INSIDE the container to a file holding the password, for docker secrets.
# Mount the secret, set this to its path, and leave NMIS_ADMIN_PASSWORD empty.
# Setting both is rejected.
NMIS_ADMIN_PASSWORD_FILE=

# Where Mongo is published on the host. Loopback keeps the database off the
# network: Docker writes its NAT rules ahead of the host firewall, so a port
# published on 0.0.0.0 is reachable even when iptables or ufw denies it.
# Caveat: on Docker Engine older than 28.0.0, hosts on the same network switch
# can still reach ports published to localhost (moby/moby#45610). Upgrade the
# engine, or firewall this port at the network.
MONGODB_BIND_ADDR=127.0.0.1
MONGODB_HOST_PORT=27017

# How the app reaches Mongo inside the compose network, passed to NMIS as
# NMIS_DB_SERVER / NMIS_DB_PORT. Not interchangeable with the two above:
# pointing the app at the host port makes it dial a port mongod is not
# listening on. MONGODB_PORT also sets mongod's own port and the healthcheck.
# Replaces the former NMIS_DB_PORT setting.
MONGODB_SERVER=mongo
MONGODB_PORT=27017

# Host-visible names and ports. To run a second stack on this host, set
# COMPOSE_PROJECT_NAME (which isolates volumes and the network) and give these
# distinct values, e.g. COMPOSE_PROJECT_NAME=nmis-b, NMIS_CONTAINER_NAME=nmis-b,
# MONGO_CONTAINER_NAME=mongo-b, NMIS_HTTP_PORT=8081, MONGODB_HOST_PORT=27018.
# MONGODB_SERVER and MONGODB_PORT stay as they are; each stack has its own Mongo.
NMIS_CONTAINER_NAME=nmis
MONGO_CONTAINER_NAME=mongo
NMIS_BIND_ADDR=0.0.0.0
NMIS_HTTP_PORT=8080
NMIS_SNMP_PORT=10001
