#
# Common-CiscoStatus-test.nmis
# Demo common model used by t_omk12375_traceability.pl Section E.
# Mirrors the fanStatus section from Common-Cisco-status.nmis so we can
# verify that _source_file is stamped as 'Common-CiscoStatus-test'
# (not the primary model) when a fan alert fires.
#
%hash = (
  'alerts' => {
    'fanStatus' => {
      'fanValue' => {
        'element' => 'index',
        'event'   => 'FAN Status',
        'level'   => 'Warning',
        'test'    => 'CVAR1=fanValue;$CVAR1 < 80',
        'type'    => 'test',
        'title'   => 'Fan Status',
        'unit'    => '',
        'value'   => 'CVAR1=fanValue;int($CVAR1)',
      }
    }
  },
  'systemHealth' => {
    'rrd' => {
      'fanStatus' => {
        'graphtype' => 'fan-status',
        'indexed'   => 'true',
        'snmp'      => {
          'fanValue' => {
            'oid' => 'ciscoEnvMonFanState',
            'replace' => {
              '1' => '100',
              '2' => '75',
              '3' => '0',
              '4' => '80',
              '5' => '90',
              '6' => '50',
            }
          }
        }
      }
    },
    'sys' => {
      'fanStatus' => {
        'indexed' => 'ciscoEnvMonFanStatusDescr',
        'headers' => 'FanStatusDescr',
        'snmp'    => {
          'FanStatusDescr' => {
            'oid'   => 'ciscoEnvMonFanStatusDescr',
            'title' => 'Fan Status Descr',
          },
          'fanValue' => {
            'oid' => 'ciscoEnvMonFanState',
            'replace' => {
              '1' => '100',
              '2' => '75',
              '3' => '0',
              '4' => '80',
              '5' => '90',
              '6' => '50',
            }
          }
        }
      }
    }
  },
);
