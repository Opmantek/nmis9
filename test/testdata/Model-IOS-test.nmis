#
# Model-IOS-test.nmis
# Demo test model used by t_omk12375_traceability.pl Section E.
# Mirrors the structure of Model-CatalystIOS: pulls in a Common file
# that carries the fan alert, so we can test _source_file tagging
# and Override-Common-* behaviour without touching production models.
#
%hash = (
  '-common-' => {
    'class' => {
      'status' => {
        'common-model' => 'CiscoStatus-test'
      }
    }
  },
  'system' => {
    'nodeModel' => 'IOS-test',
    'nodeType'  => 'router',
  },
);
