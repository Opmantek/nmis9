# Docker Compose .env file for NMIS Suite
MONGODB_USERNAME=root
MONGODB_PASSWORD=example
# dev convenience only, like MONGODB_PASSWORD above. The production .env keeps
# this EMPTY on purpose. Do not copy this line into it.
NMIS_ADMIN_PASSWORD=devadmin
NMIS_SERVER_NAME=nmis
NMIS_CLUSTER_ID=5140a985-5d9b-4602-8969-ead7b3e3c00f
DEV_UID=10002
DEV_GID=10002

# Where Mongo is published on the host. Loopback still lets host-side test runs
# connect to 127.0.0.1:27017 while keeping the database off the network: Docker
# writes its NAT rules ahead of the host firewall, so a port published on
# 0.0.0.0 is reachable even when iptables or ufw denies it.
# Caveat: on Docker Engine older than 28.0.0, hosts on the same network switch
# can still reach ports published to localhost (moby/moby#45610).
MONGODB_BIND_ADDR=127.0.0.1
MONGODB_HOST_PORT=27017

# How the app reaches Mongo inside the compose network, passed to NMIS as
# NMIS_DB_SERVER / NMIS_DB_PORT. Not interchangeable with the two above:
# pointing the app at the host port makes it dial a port mongod is not
# listening on. MONGODB_PORT also sets mongod's own port and the healthcheck.
MONGODB_SERVER=mongo
MONGODB_PORT=27017

# Host-visible names and ports. To run a second dev stack alongside this one,
# set COMPOSE_PROJECT_NAME (which isolates volumes and the network) and give
# these distinct values, e.g. COMPOSE_PROJECT_NAME=nmis-b,
# NMIS_CONTAINER_NAME=nmis-b, MONGO_CONTAINER_NAME=mongo-b, NMIS_HTTP_PORT=8081,
# NMIS_SNMP_PORT=10002, MONGODB_HOST_PORT=27018.
NMIS_CONTAINER_NAME=nmis
MONGO_CONTAINER_NAME=mongo
NMIS_BIND_ADDR=0.0.0.0
NMIS_HTTP_PORT=8080
NMIS_SNMP_PORT=10001
