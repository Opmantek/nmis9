# Docker Compose .env file for NMIS Suite
MONGODB_USERNAME=root
MONGODB_PASSWORD=example
NMIS_SERVER_NAME=nmis
NMIS_CLUSTER_ID=5140a985-5d9b-4602-8969-ead7b3e3c00f
DEV_UID=10002
DEV_GID=10002

# OMK-12708. Where the Mongo container's port is published on the host.
# Loopback keeps host-side test runs working (they connect to 127.0.0.1:27017)
# while removing the exposure that "27017:27017" gave. Docker port publishing
# writes NAT rules ahead of the host firewall, so the old default was reachable
# from the network even with iptables or ufw denying it.
#
# One caveat, on Docker Engine older than 28.0.0 only. Docker's documentation
# warns that "In releases older than 28.0.0, hosts within the same L2 segment
# (for example, hosts connected to the same network switch) can reach ports
# published to localhost" (moby/moby#45610). So on an older engine 127.0.0.1 is
# not a complete boundary. Upgrade the engine, or firewall 27017 at the network.
MONGODB_BIND_ADDR=127.0.0.1

# Host-side port. Bump this to run a second dev stack alongside the first.
# The container-side port stays 27017.
MONGODB_HOST_PORT=27017

# OMK-12708. How the NMIS container reaches Mongo, fed to the app as
# NMIS_DB_SERVER / NMIS_DB_PORT. NMIS overrides any config key from NMIS_<KEY>
# in the environment, so these take effect without editing conf/Config.nmis.
#
# These are the CONTAINER side, i.e. inside the compose network. They are NOT
# the same as MONGODB_BIND_ADDR / MONGODB_HOST_PORT above, which are only about
# where the port is published on the host. Pointing the app at the host port
# would make it dial a port mongod is not listening on. MONGODB_PORT drives the
# container port everywhere at once: mongod's --port, the container side of the
# published mapping, the healthcheck, and NMIS_DB_PORT.
#
# MONGODB_SERVER only redirects the APP. It does not reconfigure the bundled
# mongo service, whose own identity stays 'mongo' (its hostname on the compose
# network, its bindIp, and its healthcheck). Pointing this at an external
# database means the bundled mongo service should not be running at all.
MONGODB_SERVER=mongo
MONGODB_PORT=27017
