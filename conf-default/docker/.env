# Docker Compose .env file for NMIS Suite
MONGODB_USERNAME=root
# The mongo root/admin password. Placeholder only - production must NOT ship a
# working password. Run `make prod-setup` to generate a strong value here;
# `make prod-up` refuses to start while this is still a default. (setup_mongodb.pl
# would also refuse to honour this literal value: it is in its deny set alongside
# '', 'example', 'password' and 'op42flow42', and GENERATES its own password
# instead - the whole reason a placeholder like this cannot be left in place.)
MONGODB_PASSWORD=CHANGE_ME_run_make_prod-setup
# The scoped nmis9RW application password, DISTINCT from the root password above
# (OMK-12826), so reading the app config or env does not yield the root password.
# Placeholder only, generated as a SEPARATE strong value by `make prod-setup`;
# `make prod-up` refuses to start while it is still a default. It must be off the
# deny set, or setup_mongodb.pl generates a random one for nmis9RW while the app
# keeps authenticating with this value, and auth fails.
MONGODB_APP_PASSWORD=CHANGE_ME_run_make_prod-setup
NMIS_SERVER_NAME=nmis

# Where Mongo is published on the host. Loopback keeps the database off the
# network: Docker writes its NAT rules ahead of the host firewall, so a port
# published on 0.0.0.0 is reachable even when iptables or ufw denies it.
# Caveat: on Docker Engine older than 28.0.0, hosts on the same network switch
# can still reach ports published to localhost (moby/moby#45610). Upgrade the
# engine, or firewall this port at the network.
MONGODB_BIND_ADDR=127.0.0.1
MONGODB_HOST_PORT=27017

# How the app reaches Mongo inside the compose network, passed to NMIS as
# NMIS_DB_SERVER / NMIS_DB_PORT. Not interchangeable with the two above:
# pointing the app at the host port makes it dial a port mongod is not
# listening on. MONGODB_PORT also sets mongod's own port and the healthcheck.
MONGODB_SERVER=mongo
MONGODB_PORT=27017

# Host-visible publish settings. To run a second stack on this host, set
# COMPOSE_PROJECT_NAME (which isolates volumes and the network) and give these
# distinct values, e.g. COMPOSE_PROJECT_NAME=nmis-b, NMIS_HTTP_PORT=8081,
# MONGODB_HOST_PORT=27018. The compose file beside this one sets no
# container_name, so container names never collide.
NMIS_BIND_ADDR=0.0.0.0
NMIS_HTTP_PORT=8080
