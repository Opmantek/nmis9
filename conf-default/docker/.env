# Docker Compose .env file for NMIS Suite
MONGODB_USERNAME=root
MONGODB_PASSWORD=example
NMIS_SERVER_NAME=nmis

# OMK-12708. Where the Mongo container's port is published on the host.
#
# Docker publishes ports by writing its own NAT rules, which are evaluated
# before the host firewall, so a published port is reachable even when iptables
# or ufw is set to deny it. The previous default published on every interface,
# putting the database holding device data and credentials on the network.
#
# 127.0.0.1 keeps it reachable from this host only. Set a specific address if a
# named remote host must reach the database, and firewall it at the network
# rather than trusting the host firewall. 0.0.0.0 restores the old exposed
# behaviour and should not be used.
#
# One caveat, on Docker Engine older than 28.0.0 only. Docker's documentation
# warns that "In releases older than 28.0.0, hosts within the same L2 segment
# (for example, hosts connected to the same network switch) can reach ports
# published to localhost" (moby/moby#45610). So on an older engine 127.0.0.1 is
# not a complete boundary. Upgrade the engine, or firewall 27017 at the network.
MONGODB_BIND_ADDR=127.0.0.1

# Host-side port. Change to run more than one stack on a host. The
# container-side port stays 27017.
MONGODB_HOST_PORT=27017
