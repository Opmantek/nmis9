#
# Model-CiscoMerakiSDWAN.nmis - reference model for SD-WAN data pushed into
# Redis by the nmisent Go daemon (engine=meraki) and consumed by
# NMISNG::Sys::Engine::Redis. Demonstrates the `redis` source-block shape.
# See docs/superpowers/specs/2026-06-05-nmis9-redis-polling-design.md.
# Field names are the contract's example set; confirm with the nmisent side
# before assigning to real devices.
#
%hash = (
	'-common-' => {
		'class' => {
			'database' => { 'common-model' => 'database' }
		},
	},
	# RRD path for the indexed sdwan_uplink concept. Without this database.type
	# entry, makeRRDname cannot resolve a file for graphtype 'sdwan_uplink' and
	# both RRD creation and graphing fail ("failed to find database for graphtype").
	'database' => {
		'type' => {
			'sdwan_uplink' => '/nodes/$node/health/sdwan_uplink-$index.rrd',
		},
	},
	'system' => {
		'nodegraph' => 'health',
		'nodeModel' => 'CiscoMerakiSDWAN',
		'nodeType'  => 'generic',
		'sys' => {
			'standard' => {
				'redis' => {
					'-common-' => { 'concept' => 'sdwan_health', 'engine' => 'meraki', 'freshness' => 600 },
					'status'   => { 'field' => 'status', 'title' => 'Device status' },
					'cpu'      => { 'field' => 'cpu_load_5min', 'title' => 'CPU load (5m)' },
					'mem'      => { 'field' => 'memory_used_pct', 'title' => 'Memory used %' },
					'ha_role'          => { 'field' => 'ha_role',          'title' => 'HA role' },
					'ha_enabled'       => { 'field' => 'ha_enabled',       'title' => 'HA enabled' },
					'last_reported_at' => { 'field' => 'last_reported_at', 'title' => 'Last reported' },
				},
			},
			# Display-only device info. nmisent writes these nmisent_* properties to
			# the node configuration and catchall at discovery time (NOT via the
			# metrics payload), so there is nothing to collect here. skip_collect makes
			# loadInfo(system) skip the whole section before the Redis engine runs,
			# while the node-view overview loop (cgi-bin/network.pl) still reads these
			# titles and shows whatever value is present in catchall. device_type,
			# vendor and dashboard_url are intentionally absent: nmisent maps those to
			# the standard nodeType / nodeVendor / node_context_url, already displayed.
			'nodeinfo' => {
				'skip_collect' => 'true',
				'redis' => {
					'nmisent_hw_model'       => { 'title' => 'HW model' },
					'nmisent_serial'         => { 'title' => 'Serial' },
					'nmisent_mac'            => { 'title' => 'MAC' },
					'nmisent_firmware'       => { 'title' => 'Firmware' },
					'nmisent_network_id'     => { 'title' => 'Network ID' },
					'nmisent_product_type'   => { 'title' => 'Product type' },
					'nmisent_address'        => { 'title' => 'Address' },
					'nmisent_config_updated' => { 'title' => 'Config updated' },
				},
			},
		},
	},
	'systemHealth' => {
		'sections' => 'sdwan_uplink',
		'sys' => {
			'sdwan_uplink' => {
				'indexed'   => 'wan_interface',
				'index_oid' => 'wan_interface',
				'headers'   => 'wan_interface,status,latency,loss,ip,gateway,public_ip,primary_dns,secondary_dns,ip_assigned_by',
				'redis' => {
					'-common-'      => { 'concept' => 'sdwan_uplink', 'engine' => 'meraki', 'freshness' => 600 },
					'wan_interface' => { 'field' => 'wan_interface', 'title' => 'WAN interface' },
					'status'        => { 'field' => 'status', 'title' => 'Status' },
					'latency'       => { 'field' => 'latency_ms', 'title' => 'Latency (ms)' },
					'loss'           => { 'field' => 'loss_pct',       'title' => 'Loss (%)' },
					'ip'             => { 'field' => 'ip',             'title' => 'Uplink IP' },
					'gateway'        => { 'field' => 'gateway',        'title' => 'Gateway' },
					'public_ip'      => { 'field' => 'public_ip',      'title' => 'Public IP' },
					'primary_dns'    => { 'field' => 'primary_dns',    'title' => 'Primary DNS' },
					'secondary_dns'  => { 'field' => 'secondary_dns',  'title' => 'Secondary DNS' },
					'ip_assigned_by' => { 'field' => 'ip_assigned_by', 'title' => 'IP assigned by' },
				},
			},
		},
		'rrd' => {
			'sdwan_uplink' => {
				'graphtype' => 'sdwan_uplink,sdwan_loss',
				'indexed'   => 'wan_interface',
				'redis' => {
					'-common-' => { 'concept' => 'sdwan_uplink', 'engine' => 'meraki', 'freshness' => 600 },
					'latency'  => { 'field' => 'latency_ms', 'option' => 'gauge,0:U' },
					'loss'     => { 'field' => 'loss_pct',   'option' => 'gauge,0:100' },
				},
			},
		},
	},
);
