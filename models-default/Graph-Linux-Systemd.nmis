#
# Graph-Linux-Systemd.nmis — per-unit active/inactive flag (1=active).
#
%hash = (
	'heading' => 'Systemd Unit $index',
	'title' => {
		'standard' => '$node $index - $length from $datestamp_start to $datestamp_end',
		'short'    => '$node $index - $length',
	},
	'vlabel' => {
		'standard' => 'Active (1=yes 0=no)',
		'small'    => 'state',
	},
	'option' => {
		'standard' => [
			'--upper-limit', '1',
			'--lower-limit', '0',
			'--rigid',
			'DEF:a=$database:active:AVERAGE',
			'AREA:a#7CFC00: Active',
			'GPRINT:a:AVERAGE:Avg %1.2lf',
			'GPRINT:a:MAX:Max %1.0lf',
			'GPRINT:a:LAST:Now %1.0lf\\n',
		],
		'small' => [
			'--upper-limit', '1',
			'--lower-limit', '0',
			'--rigid',
			'DEF:a=$database:active:AVERAGE',
			'AREA:a#7CFC00: Active',
		],
	},
);
