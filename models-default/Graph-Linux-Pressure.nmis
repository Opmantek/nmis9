#
# Graph-Linux-Pressure.nmis — Linux PSI as fraction of time stalled.
# Each ds is cumulative seconds; rate per second = fraction of time
# tasks were waiting/stalled. Multiply by 100 to render as percent.
#
%hash = (
	'heading' => 'Linux Pressure (PSI)',
	'title' => {
		'standard' => '$node PSI - $length from $datestamp_start to $datestamp_end',
		'short'    => '$node PSI - $length',
	},
	'vlabel' => {
		'standard' => 'Pressure (% of time)',
		'small'    => 'PSI %',
	},
	'option' => {
		'standard' => [
			'DEF:cpu_w=$database:psi_cpu_wait:AVERAGE',
			'DEF:io_w=$database:psi_io_wait:AVERAGE',
			'DEF:io_s=$database:psi_io_stall:AVERAGE',
			'DEF:mem_w=$database:psi_mem_wait:AVERAGE',
			'DEF:mem_s=$database:psi_mem_stall:AVERAGE',
			'CDEF:cpu_pct=cpu_w,100,*',
			'CDEF:io_pct=io_w,100,*',
			'CDEF:mem_pct=mem_w,100,*',
			'LINE1:cpu_pct#FF8C00: CPU wait',
			'GPRINT:cpu_pct:AVERAGE:Avg %5.2lf%%',
			'GPRINT:cpu_pct:MAX:Max %5.2lf%%\\n',
			'LINE1:io_pct#1E90FF: I/O wait',
			'GPRINT:io_pct:AVERAGE:Avg %5.2lf%%',
			'GPRINT:io_pct:MAX:Max %5.2lf%%\\n',
			'LINE1:mem_pct#9932CC: Memory wait',
			'GPRINT:mem_pct:AVERAGE:Avg %5.2lf%%',
			'GPRINT:mem_pct:MAX:Max %5.2lf%%\\n',
		],
		'small' => [
			'DEF:cpu_w=$database:psi_cpu_wait:AVERAGE',
			'DEF:io_w=$database:psi_io_wait:AVERAGE',
			'CDEF:cpu_pct=cpu_w,100,*',
			'CDEF:io_pct=io_w,100,*',
			'LINE1:cpu_pct#FF8C00: cpu',
			'LINE1:io_pct#1E90FF: io',
		],
	},
);
