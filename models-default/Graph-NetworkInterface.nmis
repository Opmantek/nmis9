%hash = (
	'heading' => 'Interface Utilisation',
	'title' => {
		'standard' => '$node - $length from $datestamp_start to $datestamp_end',
		'short' => '$node - $length'
	},
	'vlabel'=> {
		'standard' => '% Avg Util',
		'split' => 'In(-) Out(+) Avg Util'
	},
	'option' => {
		'standard' => [
			#'--upper-limit','100',
			#'--lower-limit','-100',
			#'--rigid',
			'DEF:Tspeed=$database:CurrentBandwidth:AVERAGE',
			'DEF:BReceivedPersec=$database:BytesReceivedPersec:AVERAGE',
			'DEF:BSentPersec=$database:BytesSentPersec:AVERAGE',
			'DEF:BTotalPersec=$database:BytesTotalPersec:AVERAGE',
			'DEF:BReceivedPersecM=$database:BytesReceivedPersec:MAX',
			'DEF:BSentPersecM=$database:BytesSentPersec:MAX',

			'CDEF:inputUtil=BReceivedPersec,8,*,Tspeed,/,100,*',
			'CDEF:inputSplitUtil=BReceivedPersec,8,*,Tspeed,/,100,*,$split,*',
			'CDEF:outputUtil=BSentPersec,8,*,Tspeed,/,100,*',
			
			'CDEF:inputUtilM=BReceivedPersecM,8,*,Tspeed,/,100,*',
			'CDEF:inputSplitUtilM=BReceivedPersecM,8,*,Tspeed,/,100,*,$split,*',
			'CDEF:outputUtilM=BSentPersecM,8,*,Tspeed,/,100,*',
			
			'$GLINE:inputSplitUtil#00BFFF: Average Input\\t',
			'LINE1:inputSplitUtilM#4169E1: Maximum Input\\t',
			'GPRINT:inputUtil:LAST:Current %4.2lf%%',
			'GPRINT:inputUtil:AVERAGE:Average %4.2lf%%',
			
			'GPRINT:inputUtil:MAX:Maximum %4.2lf%%\\n',
			'$GLINE:outputUtil#00FF7F: Average Output\\t',
			'LINE1:outputUtilM#2E8B57: Maximum Output\\t',
			'GPRINT:outputUtil:LAST:Current %4.2lf%%',
			'GPRINT:outputUtil:AVERAGE:Average %4.2lf%%',
			
			'GPRINT:outputUtil:MAX:Maximum %4.2lf%%\\n',

			#'COMMENT:Interface Speed $Tspeed\\n'

			#'LINE1:inputUtil#4169E1: Input Util\\t',
			#'$GLINE:inputSplitUtil#00BFFF: Average Input Util\\t',


		],
	}
);
