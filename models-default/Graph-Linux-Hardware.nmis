#
# Graph-Linux-Hardware.nmis — per-sensor temperature.
# Min matters: ambient swings (idle vs load) tell you cooling headroom.
#
%hash = (
	'heading' => 'Hardware Sensor $index',
	'title' => {
		'standard' => '$node $index - $length from $datestamp_start to $datestamp_end',
		'short'    => '$node $index - $length',
	},
	'vlabel' => {
		'standard' => 'Temperature (°C)',
		'small'    => '°C',
	},
	'option' => {
		'standard' => [
			'DEF:t=$database:temp_celsius:AVERAGE',
			'LINE2:t#FF0000: Temperature',
			'GPRINT:t:MIN:Min %5.1lf°C',
			'GPRINT:t:AVERAGE:Avg %5.1lf°C',
			'GPRINT:t:MAX:Max %5.1lf°C\\n',
		],
		'small' => [
			'DEF:t=$database:temp_celsius:AVERAGE',
			'LINE1:t#FF0000: Temp',
		],
	},
);
