#
# Model-TestRedis.nmis - test model used by test/t_polling_redis.pl.
# Not for real devices. A coverage fixture: every element exists to force a
# distinct part of the redis engine/processing code through the full
# collect/reconcile path (stubbed Redis client), and each is asserted by the
# test. Don't add same-path duplicates; if a new engine branch appears, add
# the one element that drives it plus its assertion.
#
# Element -> code path map:
#   system.sys.standard.redis        scalar loadInfo extraction (string + numeric field)
#   system.sys.nodeinfo              skip_collect: section skipped before the engine
#                                    (no concept declared, so a failure to skip errors)
#   system.rrd.device_health.redis   scalar time-series: collect_node_data ->
#                                    build_queries scalar -> RRD writer
#   systemHealth sdwan_uplink sys    indexed discovery + per-row extraction;
#                                    wan_interface has NO field -> index-self branch
#   systemHealth sdwan_uplink rrd    indexed time-series, two ds, two graphtypes
#                                    sharing one RRD (sdwan_uplink + sdwan_loss)
#   systemHealth sdwan_tunnel sys    composite index (['peer','tunnel'] ->
#                                    'peer__tunnel'): composite discovery,
#                                    per-component values on the inventory row,
#                                    composite row resolution in build_queries
#   database.type entries            makeRRDname resolution for both RRD concepts
#
%hash = (
	'-common-' => {
		'class' => {
			'database' => { 'common-model' => 'database' }
		},
	},
	'database' => {
		'type' => {
			'sdwan_uplink'  => '/nodes/$node/health/sdwan_uplink-$index.rrd',
			'device_health' => '/nodes/$node/health/device_health.rrd',
		},
	},
	'system' => {
		'nodegraph' => 'health',
		'nodeModel' => 'TestRedis',
		'nodeType'  => 'generic',
		'sys' => {
			'standard' => {
				'redis' => {
					'-common-' => { 'concept' => 'sdwan_health', 'engine' => 'meraki', 'freshness' => 600 },
					'status'   => { 'field' => 'status', 'title' => 'Device status' },
					'cpu'      => { 'field' => 'cpu_load_5min', 'title' => 'CPU load (5m)' },
				},
			},
			# skip_collect display-only section: loadInfo must skip it before the
			# engine runs — it declares no concept, so if the skip breaks,
			# build_queries fails loudly with "no concept in -common-".
			'nodeinfo' => {
				'skip_collect' => 'true',
				'redis' => {
					'nmisent_serial' => { 'title' => 'Serial' },
				},
			},
		},
		# Scalar time-series: device-level health values to RRD via
		# collect_node_data (class=system rrd) — the only model-driven
		# exercise of the engine's scalar RRD path.
		'rrd' => {
			'device_health' => {
				'redis' => {
					'-common-' => { 'concept' => 'sdwan_health', 'engine' => 'meraki', 'freshness' => 600 },
					'cpu' => { 'field' => 'cpu_load_5min',   'option' => 'gauge,0:U' },
					'mem' => { 'field' => 'memory_used_pct', 'option' => 'gauge,0:100' },
				},
			},
		},
	},
	'systemHealth' => {
		'sections' => 'sdwan_uplink,sdwan_tunnel',
		'sys' => {
			# composite-indexed section: two component fields synthesize the
			# inventory index ('siteA__t1'); the engine persists peer/tunnel
			# as their own inventory fields and resolves rows by the tuple.
			'sdwan_tunnel' => {
				'indexed' => ['peer', 'tunnel'],
				'headers' => 'peer,tunnel,state',
				'redis' => {
					'-common-' => { 'concept' => 'sdwan_tunnel', 'engine' => 'meraki', 'freshness' => 600 },
					'state'    => { 'field' => 'state', 'title' => 'Tunnel state' },
				},
			},
			'sdwan_uplink' => {
				'indexed'   => 'wan_interface',
				'index_oid' => 'wan_interface',
				'headers'   => 'wan_interface,status,latency,loss,ip',
				'redis' => {
					'-common-'      => { 'concept' => 'sdwan_uplink', 'engine' => 'meraki', 'freshness' => 600 },
					# no 'field': index-self item, records the row's index value
					'wan_interface' => { 'title' => 'WAN interface' },
					'status'        => { 'field' => 'status', 'title' => 'Status' },
					'latency'       => { 'field' => 'latency_ms', 'title' => 'Latency (ms)' },
					'loss'          => { 'field' => 'loss_pct', 'title' => 'Loss (%)' },
					'ip'            => { 'field' => 'ip', 'title' => 'Uplink IP' },
				},
			},
		},
		'rrd' => {
			'sdwan_uplink' => {
				'graphtype' => 'sdwan_uplink,sdwan_loss',
				'indexed'   => 'wan_interface',
				'redis' => {
					'-common-' => { 'concept' => 'sdwan_uplink', 'engine' => 'meraki', 'freshness' => 600 },
					'latency'  => { 'field' => 'latency_ms', 'option' => 'gauge,0:U' },
					'loss'     => { 'field' => 'loss_pct',   'option' => 'gauge,0:100' },
				},
			},
		},
	},
);
