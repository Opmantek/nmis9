#
# Graph-Linux-DiskIO.nmis — per-device read+write throughput.
# Counters are rate-converted by RRD, so values are bytes/sec.
#
%hash = (
	'heading' => 'Linux Disk I/O $index',
	'title' => {
		'standard' => '$node Disk $index - $length from $datestamp_start to $datestamp_end',
		'short'    => '$node Disk $index - $length',
	},
	'vlabel' => {
		'standard' => 'Bytes per second',
		'small'    => 'B/s',
	},
	'option' => {
		'standard' => [
			'DEF:rb=$database:read_bytes:AVERAGE',
			'DEF:wb=$database:write_bytes:AVERAGE',
			'DEF:r=$database:reads:AVERAGE',
			'DEF:w=$database:writes:AVERAGE',
			'CDEF:wb_neg=wb,-1,*',
			'AREA:rb#1E90FF: Read (B/s)',
			'GPRINT:rb:AVERAGE:Avg %7.1lf',
			'GPRINT:rb:MAX:Max %7.1lf\\n',
			'AREA:wb_neg#FF8C00: Write (B/s)',
			'GPRINT:wb:AVERAGE:Avg %7.1lf',
			'GPRINT:wb:MAX:Max %7.1lf\\n',
			'COMMENT:Read ops/s',
			'GPRINT:r:AVERAGE:Avg %5.1lf\\n',
			'COMMENT:Write ops/s',
			'GPRINT:w:AVERAGE:Avg %5.1lf\\n',
		],
		'small' => [
			'DEF:rb=$database:read_bytes:AVERAGE',
			'DEF:wb=$database:write_bytes:AVERAGE',
			'CDEF:wb_neg=wb,-1,*',
			'AREA:rb#1E90FF: r',
			'AREA:wb_neg#FF8C00: w',
		],
	},
);
