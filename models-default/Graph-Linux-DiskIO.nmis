#
# Graph-Linux-DiskIO.nmis — per-device read+write throughput (mirrored axes).
# Bytes/sec on the y-axis, ops/sec in the legend. --base 1024 for auto-scaled units.
#
%hash = (
	'heading' => 'Linux Disk I/O $index',
	'title' => {
		'standard' => '$node Disk $index - $length from $datestamp_start to $datestamp_end',
		'short'    => '$node Disk $index - $length',
	},
	'vlabel' => {
		'standard' => 'Bytes per second',
		'small'    => 'B/s',
	},
	'option' => {
		'standard' => [
			'--base', '1024',
			'DEF:rb=$database:read_bytes:AVERAGE',
			'DEF:wb=$database:write_bytes:AVERAGE',
			'DEF:r=$database:reads:AVERAGE',
			'DEF:w=$database:writes:AVERAGE',
			'CDEF:wb_neg=wb,-1,*',
			'AREA:rb#1E90FF: Read',
			'GPRINT:rb:AVERAGE:Avg %7.2lf%sB/s',
			'GPRINT:rb:MAX:Max %7.2lf%sB/s\\n',
			'AREA:wb_neg#FF8C00: Write',
			'GPRINT:wb:AVERAGE:Avg %7.2lf%sB/s',
			'GPRINT:wb:MAX:Max %7.2lf%sB/s\\n',
			'COMMENT:Read ops',
			'GPRINT:r:AVERAGE:Avg %5.2lf/s',
			'GPRINT:r:MAX:Max %5.2lf/s\\n',
			'COMMENT:Write ops',
			'GPRINT:w:AVERAGE:Avg %5.2lf/s',
			'GPRINT:w:MAX:Max %5.2lf/s\\n',
		],
		'small' => [
			'--base', '1024',
			'DEF:rb=$database:read_bytes:AVERAGE',
			'DEF:wb=$database:write_bytes:AVERAGE',
			'DEF:r=$database:reads:AVERAGE',
			'DEF:w=$database:writes:AVERAGE',
			'CDEF:wb_neg=wb,-1,*',
			'AREA:rb#1E90FF: Read',
			'AREA:wb_neg#FF8C00: Write',
		],
	},
);
