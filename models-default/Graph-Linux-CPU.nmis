#
# Graph-Linux-CPU.nmis — per-core CPU time by mode (counters).
# RRD COUNTER converts cumulative seconds to per-second rates; modes
# sum to 1.0 (= 100%). Multiplied by 100 in CDEFs so the y-axis is
# pinned 0–100% via --upper-limit / --rigid.
#
%hash = (
	'heading' => 'Linux CPU $index',
	'title' => {
		'standard' => '$node CPU $index - $length from $datestamp_start to $datestamp_end',
		'short'    => '$node CPU $index - $length',
	},
	'vlabel' => {
		'standard' => '% CPU Time',
		'small'    => '% CPU',
	},
	'option' => {
		'standard' => [
			'--upper-limit', '100',
			'--lower-limit', '0',
			'--rigid',
			'DEF:user=$database:mode_user:AVERAGE',
			'DEF:sys=$database:mode_system:AVERAGE',
			'DEF:wait=$database:mode_iowait:AVERAGE',
			'DEF:irq=$database:mode_irq:AVERAGE',
			'DEF:soft=$database:mode_softirq:AVERAGE',
			'DEF:steal=$database:mode_steal:AVERAGE',
			'DEF:nice=$database:mode_nice:AVERAGE',
			'DEF:idle=$database:mode_idle:AVERAGE',
			'CDEF:user_pct=user,100,*',
			'CDEF:sys_pct=sys,100,*',
			'CDEF:wait_pct=wait,100,*',
			'CDEF:irq_pct=irq,100,*',
			'CDEF:soft_pct=soft,100,*',
			'CDEF:steal_pct=steal,100,*',
			'CDEF:nice_pct=nice,100,*',
			'CDEF:idle_pct=idle,100,*',
			'AREA:user_pct#1E90FF: User',
			'STACK:nice_pct#9370DB: Nice',
			'STACK:sys_pct#FF8C00: System',
			'STACK:wait_pct#FF6347: I/O Wait',
			'STACK:irq_pct#FFD700: IRQ',
			'STACK:soft_pct#DAA520: Soft IRQ',
			'STACK:steal_pct#FF0000: Steal',
			'STACK:idle_pct#90EE90: Idle',
			'GPRINT:user_pct:AVERAGE:User Avg %5.2lf%%',
			'GPRINT:user_pct:MAX:Max %5.2lf%%\\n',
			'GPRINT:sys_pct:AVERAGE:System Avg %5.2lf%%',
			'GPRINT:sys_pct:MAX:Max %5.2lf%%\\n',
			'GPRINT:wait_pct:AVERAGE:I/O Wait Avg %5.2lf%%',
			'GPRINT:wait_pct:MAX:Max %5.2lf%%\\n',
			'GPRINT:idle_pct:AVERAGE:Idle Avg %5.2lf%%',
			'GPRINT:idle_pct:MAX:Max %5.2lf%%\\n',
		],
		'small' => [
			'--upper-limit', '100',
			'--lower-limit', '0',
			'--rigid',
			'DEF:user=$database:mode_user:AVERAGE',
			'DEF:sys=$database:mode_system:AVERAGE',
			'DEF:wait=$database:mode_iowait:AVERAGE',
			'DEF:irq=$database:mode_irq:AVERAGE',
			'DEF:soft=$database:mode_softirq:AVERAGE',
			'DEF:steal=$database:mode_steal:AVERAGE',
			'DEF:nice=$database:mode_nice:AVERAGE',
			'DEF:idle=$database:mode_idle:AVERAGE',
			'CDEF:user_pct=user,100,*',
			'CDEF:sys_pct=sys,100,*',
			'CDEF:wait_pct=wait,100,*',
			'CDEF:irq_pct=irq,100,*',
			'CDEF:soft_pct=soft,100,*',
			'CDEF:steal_pct=steal,100,*',
			'CDEF:nice_pct=nice,100,*',
			'CDEF:idle_pct=idle,100,*',
			'AREA:user_pct#1E90FF: User',
			'STACK:nice_pct#9370DB: Nice',
			'STACK:sys_pct#FF8C00: Sys',
			'STACK:wait_pct#FF6347: Wait',
			'STACK:irq_pct#FFD700: IRQ',
			'STACK:soft_pct#DAA520: SIRQ',
			'STACK:steal_pct#FF0000: Steal',
			'STACK:idle_pct#90EE90: Idle',
		],
	},
);
