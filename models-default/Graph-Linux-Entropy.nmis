#
# Graph-Linux-Entropy.nmis — kernel RNG pool depth.
#
%hash = (
	'heading' => 'Linux Entropy',
	'title' => {
		'standard' => '$node Entropy - $length from $datestamp_start to $datestamp_end',
		'short'    => '$node Entropy - $length',
	},
	'vlabel' => {
		'standard' => 'Bits available in pool',
		'small'    => 'bits',
	},
	'option' => {
		'standard' => [
			'DEF:avail=$database:entropy_avail:AVERAGE',
			'DEF:pool=$database:entropy_pool:AVERAGE',
			'AREA:avail#7CFC00: Available',
			'GPRINT:avail:AVERAGE:Avg %5.0lf',
			'GPRINT:avail:MIN:Min %5.0lf\\n',
			'LINE1:pool#FF0000: Pool size',
			'GPRINT:pool:LAST:Now %5.0lf\\n',
		],
		'small' => [
			'DEF:avail=$database:entropy_avail:AVERAGE',
			'AREA:avail#7CFC00: avail',
		],
	},
);
