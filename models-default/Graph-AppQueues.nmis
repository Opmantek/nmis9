#
# Graph for indexed application queue metrics from a Prometheus endpoint.
# DS names match Model-Linux-HTTP.nmis systemHealth.AppQueues.rrd:
#   depth     - current queue depth (gauge)
#   processed - total messages processed (counter)
#

%hash = (
	'heading' => 'Application Queue $index',
	'title' => {
		'standard' => '$node $index - $length from $datestamp_start to $datestamp_end',
		'short'    => '$node $index - $length',
	},
	'vlabel' => {
		'standard' => 'Queue depth (msgs) / Processed rate (msgs/sec)',
		'small'    => 'Queue / Rate',
	},
	'option' => {
		'standard' => [
			'DEF:depth=$database:depth:AVERAGE',
			'DEF:processed=$database:processed:AVERAGE',

			'LINE1:depth#00BFFF: Queue Depth',
			'GPRINT:depth:MIN:Min %5.1lf',
			'GPRINT:depth:AVERAGE:Avg %5.1lf',
			'GPRINT:depth:MAX:Max %5.1lf\\n',

			'LINE1:processed#FFA500: Processed Rate (msg/sec)',
			'GPRINT:processed:MIN:Min %5.2lf',
			'GPRINT:processed:AVERAGE:Avg %5.2lf',
			'GPRINT:processed:MAX:Max %5.2lf\\n',
		],
		'small' => [
			'DEF:depth=$database:depth:AVERAGE',
			'DEF:processed=$database:processed:AVERAGE',
			'LINE1:depth#00BFFF: Depth',
			'GPRINT:depth:AVERAGE:Avg %1.0lf\\n',
			'LINE1:processed#FFA500: Rate',
			'GPRINT:processed:AVERAGE:Avg %1.2lf\\n',
		],
	},
);
