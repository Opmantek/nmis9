#
# Model-TestDual.nmis - Test model for dual-protocol (SNMP + WMI) polling validation.
# Used by test/t_sys_dual.pl; do not assign to real devices.
# Mirrors fragments of Model-TestSnmp and Model-TestWmi so one node can
# simultaneously exercise both engines.
#
%hash = (
	'-common-' => {
		'class' => {
			'database' => {
				'common-model' => 'database'
			}
		}
	},
	'system' => {
		'nodegraph' => 'health,response',
		'nodeModel' => 'TestDual',
		'nodeType'  => 'generic',
		'sys' => {
			'standard' => {
				'snmp' => {
					'sysDescr' => {
						'oid'   => 'sysDescr',
						'title' => 'Description'
					},
					'sysObjectID' => {
						'oid' => 'sysObjectID'
					},
					'sysUpTime' => {
						'oid'   => 'sysUpTime',
						'title' => 'Uptime'
					},
					'sysName' => {
						'oid'   => 'sysName',
						'title' => 'System Name'
					},
					'ifNumber' => {
						'oid'   => 'ifNumber',
						'title' => 'Interfaces'
					}
				},
				'wmi' => {
					'winosname' => {
						'query' => 'select Caption from Win32_OperatingSystem',
						'field' => 'Caption',
						'title' => 'OS Name'
					},
					'winsysname' => {
						'query' => 'select CSName from Win32_OperatingSystem',
						'field' => 'CSName',
						'title' => 'WMI System Name'
					}
				}
			}
		},
		'rrd' => {
			'mib2ip' => {
				'graphtype' => 'ip,fwd',
				'snmp' => {
					'ipInReceives' => {
						'oid'    => 'ipInReceives',
						'option' => 'counter,0:U',
						'title'  => 'IP In Receives'
					},
					'ipOutRequests' => {
						'oid'    => 'ipOutRequests',
						'option' => 'counter,0:U',
						'title'  => 'IP Out Requests'
					}
				}
			},
			'wmiCpu' => {
				'graphtype' => 'wmiCpu',
				'wmi' => {
					'percentProcessor' => {
						'query'  => "select PercentProcessorTime from Win32_PerfFormattedData_PerfOS_Processor where Name='_Total'",
						'field'  => 'PercentProcessorTime',
						'option' => 'gauge,0:U',
						'title'  => 'CPU Usage'
					}
				}
			}
		}
	},
	'systemHealth' => {
		'sections' => 'testSensor,wmiDisk',
		'sys' => {
			'testSensor' => {
				'indexed'   => 'testSensorName',
				'index_oid' => '1.3.6.1.4.1.99999.1.1.1.2',
				'headers'   => 'testSensorName',
				'snmp' => {
					'testSensorName' => {
						'oid'           => '1.3.6.1.4.1.99999.1.1.1.2',
						'title'         => 'Sensor Name',
						'sysObjectName' => 'testSensorName'
					}
				}
			},
			'wmiDisk' => {
				'indexed' => 'Name',
				'headers' => 'Name',
				'wmi' => {
					'Name' => {
						'query'   => 'select Name,Size,FreeSpace from Win32_LogicalDisk where DriveType=3',
						'field'   => 'Name',
						'title'   => 'Disk Name',
						'indexed' => 'true'
					}
				}
			}
		},
		'rrd' => {
			'testSensor' => {
				'graphtype' => 'testSensor',
				'indexed'   => 'true',
				'snmp' => {
					'testSensorValue' => {
						'oid'           => '1.3.6.1.4.1.99999.1.1.1.3',
						'option'        => 'gauge,0:U',
						'title'         => 'Sensor Value',
						'sysObjectName' => 'testSensorValue'
					}
				}
			},
			'wmiDisk' => {
				'graphtype' => 'wmiDisk',
				'indexed'   => 'Name',
				'wmi' => {
					'wmiDiskFreeSpace' => {
						'query'  => 'select Name,Size,FreeSpace from Win32_LogicalDisk where DriveType=3',
						'field'  => 'FreeSpace',
						'option' => 'gauge,0:U',
						'title'  => 'Free Space'
					}
				}
			}
		}
	},
	'stats' => {
		'type' => {
			'health' => [
				'DEF:reachability=$database:reachability:AVERAGE',
				'DEF:availability=$database:availability:AVERAGE',
				'PRINT:reachability:AVERAGE:reachability=%1.2lf',
				'PRINT:availability:AVERAGE:availability=%1.2lf'
			]
		}
	}
);
