%hash = (
	'system' => {
		'rrd' => {
			'WindowsProcessor' => {
				'graphtype' => 'WindowsProcessor',
				'threshold' => 'WindowsProcessor',
				'wmi' => {
					"-common-" => {
						'query' => 'select * from win32_perfformatteddata_PerfOS_Processor where name = "_Total"',
					},
					'dpcsQueuedPersec' => {
						'field' => 'DPCsQueuedPersec',
						'option' => 'gauge,0:U',
					},
					'interruptsPersec' => {
						'field' => 'InterruptsPersec',
						'option' => 'gauge,0:U',
					},
					'percentDpc' => {
						'field' => 'PercentDPCTime',
						'option' => 'gauge,0:U',
					},
					'percentIdle' =>{
						'field' => 'PercentIdleTime',
						'option' => 'gauge,0:U',
					},
					'percentInterrupt' => {
						'field' => 'PercentInterruptTime',
						'option' => 'gauge,0:U',
					},
					'percentPrivileged' => {
						'field' => 'PercentPrivilegedTime',
						'option' => 'gauge,0:U',
					},
					'percentProcessor' => {
						'field' => 'PercentProcessorTime',
						'option' => 'gauge,0:U',
					},
					'percentUser' => {
						'field' => 'PercentUserTime',
						'option' => 'gauge,0:U',
					},
				},
			},    
		},
	},
	'systemHealth' => {
		'sys' => {
			'WindowsPagefile' => {
				'headers' => 'Name,pageTotal,pageUsage',
				'indexed' => 'Name',
				'wmi' => {
					"-common-" => {
						'query' => 'select * from win32_pagefileusage',
					},
					'Name' => {
						'field' => 'Name',
						'title' => 'Name'
					},
					'pageUsage' => {
						'field' => 'CurrentUsage',
						'calculate' => 'return $r*(1<<20);',
						'title' => 'Usage'
					},
					'pageTotal' => {
						'field' => 'AllocatedBaseSize',
						'calculate' => 'return $r*(1<<20);',
						'title' => 'Size'
					},
				},
			},
			'LogicalDisk' => {
				'headers' => 'Name,Description,FreeSpace',
				'indexed' => 'Name',
				'wmi' => {
					'Name' => {
						'query' => 'select * from Win32_PerfRawData_PerfDisk_LogicalDisk',
						'field' => 'Name',
						'title' => 'name of the disk device',
					},
					'Description' => {
						'query' => 'select * from Win32_PerfRawData_PerfDisk_LogicalDisk',
						'field' => 'Description',
						'title' => 'optional description of the disk device',
					},
					'FreeSpace' => {
						'query' => 'select * from Win32_PerfRawData_PerfDisk_LogicalDisk',
						'field' => 'FreeMegabytes',
						'title' => 'free space in bytes of the disk device',
						'calculate' => 'return $r * (1<<20);',
					},
				},
			},
			'TCPMetrics' => {
				'headers' => 'ConnectionsActive,ConnectionFailures,ConnectionsEstablished',
				'indexed' => 'ConnectionsActive',
				'wmi' => {
					'ConnectionsActive' => {
						'query' => 'select * from Win32_PerfRawData_Tcpip_TCPv4',
						'field' => 'ConnectionsActive',
						'title' => 'Local TCP Connections',
					},
					'ConnectionFailures' => {
						'query' => 'select * from Win32_PerfRawData_Tcpip_TCPv4',
						'field' => 'ConnectionFailures',
						'title' => 'Remote TCP Connection Failures',
					},
					'ConnectionsEstablished' => {
						'query' => 'select * from Win32_PerfRawData_Tcpip_TCPv4',
						'field' => 'ConnectionsEstablished',
						'title' => 'TCP Connections Established',
					},
				},
			},
			'UDPMetrics' => {
				'headers' => 'DatagramsReceivedPersec,DatagramsSentPersec,DatagramsReceivedErrors',
				'indexed' => 'DatagramsReceivedPersec',
				'wmi' => {
					'DatagramsReceivedPersec' => {
						'query' => 'select * from Win32_PerfRawData_Tcpip_UDPv4',
						'field' => 'DatagramsReceivedPersec',
						'title' => 'Datagrams Received Per Second',
					},
					'DatagramsSentPersec' => {
						'query' => 'select * from Win32_PerfRawData_Tcpip_UDPv4',
						'field' => 'DatagramsSentPersec',
						'title' => 'Datagrams Sent Per Second',
					},
					'DatagramsReceivedErrors' => {
						'query' => 'select * from Win32_PerfRawData_Tcpip_UDPv4',
						'field' => 'DatagramsReceivedErrors',
						'title' => 'Datagrams Sent Per Second',
					},
				},
			},
			'Utilmemory' => {
				'headers' => 'TotalVisibleMemorySize,FreePhysicalMemory,TotalVirtualMemorySize,UsedMemory,MemoryUsage',
				'indexed' => 'TotalVisibleMemorySize',
				'wmi' => {
						'TotalVisibleMemorySize' => {
								'query' => 'select * from Win32_OperatingSystem',
								'field' => 'TotalVisibleMemorySize',
								'title' => 'Total Memory Size',
								'calculate' => 'return $r / 1024;'  # Convertir de KB a MB
						},
						'FreePhysicalMemory' => {
								'query' => 'select * from Win32_OperatingSystem',
								'field' => 'FreePhysicalMemory',
								'title' => 'Free Memory Size',
								'calculate' => 'return $r / 1024;'  # Convertir de KB a MB
						},
						'TotalVirtualMemorySize' => {
								'query' => 'select * from Win32_OperatingSystem',
								'field' => 'TotalVirtualMemorySize',
								'title' => 'Total Virtual Memory Size',
								'calculate' => 'return $r / 1024;'  # Convertir de KB a MB
						},
						'UsedMemory' => {
								'query' => 'select * from Win32_OperatingSystem',
								'field' => 'FreePhysicalMemory',
								#'calculate' => 'return ($TotalVisibleMemorySize - $r) / 1024;',  # Convertir de KB a MB
										'calculate' => 'CVAR1=TotalVisibleMemorySize; return ($CVAR1 - $r);',  # Calcula la memoria usada: TotalVisibleMemory - FreePhysicalMemory
										'dependencies' => ['TotalVisibleMemory', 'FreePhysicalMemory'], # Depende de estas métricas
								'title' => 'Used Memory',
						},
						'MemoryUsage' => {
								'query' => 'select * from Win32_OperatingSystem',
								'field' => 'FreePhysicalMemory',
								#'calculate' => 'return (1 - ($r / $TotalVisibleMemorySize)) * 100;',
																	'calculate' => 'CVAR1=TotalVisibleMemorySize; return sprintf("%.3f", (1 - ($r / $CVAR1)) * 100);',  # Calcula el porcentaje de memoria usada con 3 decimales
										'dependencies' => ['TotalVisibleMemory', 'FreePhysicalMemory'],  # Depende de estas métricas  
								'title' => 'Memory Usage (%) ',
						},
				},
			},
			'NetworkInterface' => {
				'headers' => 'Name,Description,CurrentBandwidth,BytesReceivedPersec,BytesSentPersec,BytesTotalPersec',
				'indexed' => 'Name',
				'wmi' => {
					'Name' => {
						'query' => 'select * from Win32_PerfFormattedData_Tcpip_NetworkInterface',
						'field' => 'Name',
						'title' => 'interface name',
					},
					'Description' => {
						'query' => 'select * from Win32_PerfFormattedData_Tcpip_NetworkInterface',
						'field' => 'Description',
						'title' => 'interface description',
					},
					'CurrentBandwidth' => {
						'query' => 'select * from Win32_PerfFormattedData_Tcpip_NetworkInterface',
						'field' => 'CurrentBandwidth',
						'title' => 'interface speed',
					},
					 'BytesReceivedPersec' => {
						'query' => 'select * from Win32_PerfFormattedData_Tcpip_NetworkInterface',
						'field' => 'BytesReceivedPersec',
						'title' => 'bytes in per sec',
					},
					 'BytesSentPersec' => {
						'query' => 'select * from Win32_PerfFormattedData_Tcpip_NetworkInterface',
						'field' => 'BytesSentPersec',
						'title' => 'bytes out per sec',
					},
					 'BytesTotalPersec' => {
						'query' => 'select * from Win32_PerfFormattedData_Tcpip_NetworkInterface',
						'field' => 'BytesTotalPersec',
						'title' => 'total bytes per sec',
					},
				},
			},
