#
# Model-Linux-HTTP.nmis — comprehensive node_exporter coverage.
#
# This file is intentionally small. All actual sys/rrd/systemHealth
# content lives in topic-specific Common-Linux-HTTP-*.nmis files,
# pulled in via the -common-.class block below. To enable or disable
# a whole category of metrics, just comment / uncomment its include
# line — that's the coarsest of three toggle layers, see the plan
# (root: nmis-monitors-devices-using-linked-hearth.md) for the others.
#
# Pre-requisites on the node:
#   - http_endpoints configured with at least { name => 'node_exporter',
#     port => 9100 } (entered via the GUI's "HTTP Endpoints (JSON)"
#     field; see conf-default/Table-Nodes.nmis for the schema).
#   - A reachable node_exporter on the node (default port 9100, path
#     /metrics). Default-off topics (Systemd, Hardware, APT, Conntrack)
#     additionally require their respective node_exporter collectors
#     to be enabled.
#

%hash = (
	'-common-' => {
		'class' => {
			# NMIS standard plumbing — every model includes these.
			'database'  => { 'common-model' => 'database' },
			'summary'   => { 'common-model' => 'summary' },
			'threshold' => { 'common-model' => 'threshold' },
			'stats'     => { 'common-model' => 'stats' },
			'event'     => { 'common-model' => 'event' },

			# Linux-HTTP categories. Each Common-Linux-HTTP-* file is
			# self-contained: it declares its own sys/rrd/systemHealth
			# sections, its own database.type RRD-path mappings for the
			# subconcepts it introduces, its own stats expressions, and
			# its own thresholds. Disabling a topic = comment one line.
			#
			# Default-on:
			'lh_load'        => { 'common-model' => 'Linux-HTTP-Load' },
			'lh_memory'      => { 'common-model' => 'Linux-HTTP-Memory' },
			'lh_cpu'         => { 'common-model' => 'Linux-HTTP-CPU' },
			'lh_filesystem'  => { 'common-model' => 'Linux-HTTP-Filesystem' },
			'lh_disk_io'     => { 'common-model' => 'Linux-HTTP-DiskIO' },
			'lh_network'     => { 'common-model' => 'Linux-HTTP-Network' },
			'lh_processes'   => { 'common-model' => 'Linux-HTTP-Processes' },
			'lh_fd'          => { 'common-model' => 'Linux-HTTP-FileDescriptors' },
			'lh_pressure'    => { 'common-model' => 'Linux-HTTP-Pressure' },
			'lh_sockets'     => { 'common-model' => 'Linux-HTTP-Sockets' },
			'lh_netstat'     => { 'common-model' => 'Linux-HTTP-Netstat' },
			'lh_vmstat'      => { 'common-model' => 'Linux-HTTP-VMstat' },
			'lh_sched'       => { 'common-model' => 'Linux-HTTP-Scheduler' },
			'lh_time'        => { 'common-model' => 'Linux-HTTP-Time' },
			'lh_os'          => { 'common-model' => 'Linux-HTTP-OS' },
			'lh_entropy'     => { 'common-model' => 'Linux-HTTP-Entropy' },
			'lh_arp'         => { 'common-model' => 'Linux-HTTP-ARP' },

			# Default-off — uncomment for hosts that have these collectors
			# enabled / are running on appropriate hardware:
			# 'lh_systemd'   => { 'common-model' => 'Linux-HTTP-Systemd' },
			# 'lh_hwmon'     => { 'common-model' => 'Linux-HTTP-Hardware' },
			# 'lh_apt'       => { 'common-model' => 'Linux-HTTP-APT' },
			# 'lh_conntrack' => { 'common-model' => 'Linux-HTTP-Conntrack' },
		},
	},

	'system' => {
		'nodeModel'  => 'Linux-HTTP',
		'nodeVendor' => 'generic',
		'nodeType'   => 'server',
		# nodegraph aggregates graphtype names that should appear on the
		# node summary page. Each Common-Linux-HTTP-* file contributes
		# its own graphtypes via systemHealth/rrd sections; this list
		# names the ones we want surfaced as direct node-page graphs
		# (vs. drilled-into via the System Health dropdown).
		# Comma-separated list of graphtypes rendered inline as thumbnails
		# on the node-view page (cgi-bin/network.pl:2696). Covers every
		# scalar Linux-HTTP topic that produces an RRD; the indexed
		# topics (CpuCores, LinuxFilesystem, LinuxDiskIO, NetInterfaces)
		# stay reachable via the System Health dropdown.
		'nodegraph'  => 'health,response,laload,Host_Memory,Linux-MemoryDetail,'
		              .'Linux-Pressure,Linux-Sockets,Linux-Netstat,Linux-VMstat,'
		              .'Linux-OomKill,Linux-Scheduler,Linux-NTP,Linux-Entropy,'
		              .'Linux-ARP,Linux-Processes,Linux-FileDescriptors',
	},

	# Aggregate list of all systemHealth sections this model can
	# populate. Each section's sys+rrd content lives in its
	# Common-Linux-HTTP-* file; if that Common file is commented out
	# above, NMIS will silently skip the section here. Centralising
	# the list is necessary because 'sections' is a string and a Common
	# file declaring its own would just clobber the others.
	'systemHealth' => {
		'sections' => 'CpuCores,LinuxFilesystem,LinuxDiskIO,NetInterfaces,SystemdUnits,HardwareSensors',
	},
);
