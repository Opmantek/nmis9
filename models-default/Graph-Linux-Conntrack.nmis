#
# Graph-Linux-Conntrack.nmis — netfilter connection tracking table size.
#
%hash = (
	'heading' => 'Linux Conntrack',
	'title' => {
		'standard' => '$node Conntrack - $length from $datestamp_start to $datestamp_end',
		'short'    => '$node Conntrack - $length',
	},
	'vlabel' => {
		'standard' => 'Entries / events',
		'small'    => 'entries',
	},
	'option' => {
		'standard' => [
			'DEF:e=$database:ct_entries:AVERAGE',
			'DEF:l=$database:ct_limit:AVERAGE',
			'DEF:d=$database:ct_drop:AVERAGE',
			'CDEF:util=e,l,/,100,*',
			'AREA:e#1E90FF: Conntrack entries',
			'GPRINT:e:AVERAGE:Avg %7.0lf',
			'GPRINT:e:MAX:Max %7.0lf\\n',
			'LINE1:l#FF0000: Limit',
			'GPRINT:l:LAST:%7.0lf\\n',
			'GPRINT:util:AVERAGE:Util avg %1.2lf%%',
			'GPRINT:util:MAX:max %1.2lf%%\\n',
			'LINE2:d#000000: Drops',
			'GPRINT:d:LAST:Now %5.0lf\\n',
		],
		'small' => [
			'DEF:e=$database:ct_entries:AVERAGE',
			'AREA:e#1E90FF: entries',
		],
	},
);
