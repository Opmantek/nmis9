%hash = (
  'mqtt' => {
    'topic'         => 'nmis/event', # or whatever you like e.g. your/mqtt/topic
    'server'        => 'your.mqtt.server:1883',
    'username'      => 'your_mqtt_username',
    'password'      => 'your_mqtt_password',
    'extra_logging' => 0,
    'retain' => 1,
    'retries' => 1,
    # Permit plaintext-MQTT login (sets MQTT_SIMPLE_ALLOW_INSECURE_LOGIN).
    # This plugin only speaks plaintext MQTT, so this must be true (the
    # default when the key is absent) for events to publish. Set to 0 only
    # to deliberately disable this notifier.
    'allow_insecure' => 1,
  },
  # Optional mqtt secondary server for highly available messaging or just general flexibility.
  # To use uncomment and complete the required details.
  #'mqtt_secondary' => {
  #  'topic'         => 'nmis/event', # or whatever you like e.g. your/mqtt/topic
  #  'server'        => 'your_other.mqtt.server:1883',
  #  'username'      => 'your_other_mqtt_username',
  #  'password'      => 'your_other_mqtt_password',
  #}
);
